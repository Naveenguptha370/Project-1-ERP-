PROJECT_NAME=SmartERP
VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=false

# Leave SECRET_KEY unset for an ephemeral local key, or generate a persistent key:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# This project uses SQLite.
DATABASE_URL=sqlite:///./smarterp.db

# Optional: set both values to provision an initial administrator.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin
# ADMIN_FULL_NAME=ERP Administrator

# Browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
