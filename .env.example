# SmartERP Environment Configuration
PROJECT_NAME="SmartERP"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace_with_a_super_secret_random_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
# For PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smarterp"
# Fallback SQLite format (works automatically if postgres is not running):
# DATABASE_URL="sqlite:///./smarterp.db"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Initial Super Admin (Created during seed)
ADMIN_DEFAULT_EMAIL="admin@smarterp.com"
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="AdminPassword123!"
ADMIN_DEFAULT_NAME="System Administrator"
